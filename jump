<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Cosmetic Creator DIY - CrazyLabs Style Build</title>
    <style>
        :root {
            --bg-dark: #090a10;
            --bg-card: #151824;
            --pink-accent: #ff4757;
            --primary: #4eedf6;
            --text-light: #f5f6fa;
            --text-muted: #a4a6b5;
            --border: rgba(255, 255, 255, 0.08);
        }
        * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
        body, html { width: 100%; height: 100%; background-color: var(--bg-dark); color: var(--text-light); overflow: hidden; }
        
        #game-frame { display: grid; grid-template-columns: 300px 1fr; width: 100%; height: 100%; }
        
        /* Left Hand Command Console / Dashboard view */
        #clik-panel { background-color: var(--bg-card); border-right: 1px solid var(--border); padding: 24px; display: flex; flex-direction: column; justify-content: space-between; }
        .hub-title { font-size: 18px; font-weight: 900; letter-spacing: 1px; color: var(--pink-accent); text-transform: uppercase; margin-bottom: 20px; }
        
        .metric-box { background: rgba(0,0,0,0.3); border: 1px solid var(--border); padding: 14px; border-radius: 12px; margin-bottom: 12px; }
        .metric-lbl { font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
        .metric-val { font-size: 24px; font-weight: 800; margin-top: 4px; color: #fff; }
        .metric-val.green { color: #2ed573; }

        /* Ingredient Selection Buttons Layout */
        .controls-group { margin-top: 24px; }
        .section-lbl { font-size: 12px; font-weight: bold; text-transform: uppercase; color: var(--primary); margin-bottom: 10px; }
        .ing-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
        .ing-btn { background-color: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 12px; padding: 12px; color: #fff; font-weight: bold; font-size: 12px; cursor: pointer; text-align: center; transition: all 0.2s; }
        .ing-btn:active { background-color: var(--pink-accent); transform: scale(0.95); border-color: transparent; }
        
        .action-btn { width: 100%; padding: 16px; border: none; border-radius: 16px; background: linear-gradient(135deg, var(--pink-accent), #ff6b81); color: #fff; font-weight: 900; text-transform: uppercase; font-size: 14px; cursor: pointer; letter-spacing: 1px; margin-top: 20px; box-shadow: 0 6px 20px rgba(255,71,87,0.3); }
        .action-btn:disabled { opacity: 0.3; cursor: not-allowed; box-shadow: none; }

        /* Main 3D Viewport Frame */
        #render-viewport { position: relative; height: 100%; width: 100%; }
        #canvas-container { width: 100%; height: 100%; }

        /* HUD Instructional Text Overlays */
        #hud-instruction { position: absolute; top: 20px; left: 20px; font-size: 15px; font-weight: bold; background: rgba(9,10,16,0.85); border-left: 4px solid var(--pink-accent); padding: 10px 18px; border-radius: 4px 12px 12px 4px; pointer-events: none; }
    </style>
    <!-- Core 3D Graphics Engine framework dependencies -->
    <script src="https://cloudflare.com"></script>
</head>
<body>

    <div id="game-frame">
        <!-- Dashboard Metrics Bar Configuration -->
        <div id="clik-panel">
            <div>
                <div class="hub-title">🧪 CLIK Lab Tracker</div>
                
                <div class="metric-box">
                    <div class="metric-lbl">Target Market CPI</div>
                    <div class="metric-val" id="m-cpi">$0.00</div>
                </div>
                <div class="metric-box">
                    <div class="metric-lbl">Day 1 Retention</div>
                    <div class="metric-val green" id="m-ret">0%</div>
                </div>

                <div class="controls-group">
                    <div class="section-lbl">Add Raw Components</div>
                    <div class="ing-grid">
                        <button class="ing-btn" onclick="injectIngredient(0xff4757, 'Neon Pink')">💗 Pink</button>
                        <button class="ing-btn" onclick="injectIngredient(0x1e90ff, 'Ocean Blue')">💙 Blue</button>
                        <button class="ing-btn" onclick="injectIngredient(0xffa502, 'Gold Dust')">✨ Gold</button>
                        <button class="ing-btn" onclick="injectIngredient(0xffffff, 'Gloss Base')">🥛 Base</button>
                    </div>
                </div>
                
                <button class="action-btn" id="blend-trigger" disabled onclick="executeFluidBlendingSequence()">Blend Mixture 🌀</button>
            </div>
            
            <div style="font-size:11px; opacity:0.4; line-height:1.4;">CrazyLabs DIY Simulator Layout Engine v1.0.0</div>
        </div>

        <!-- Gameplay Stage Viewport -->
        <div id="render-viewport">
            <div id="hud-instruction">Step 1: Inject raw components into the mix bowl.</div>
            <div id="canvas-container"></div>
        </div>
    </div>

    <script>
        // --- 3D SCENE & ENGINE INITIALIZATION ROUTINE ---
        let ingredientsCount = 0;
        let mixedColorValues = new THREE.Color(0xffffff);
        let blendingActive = false;

        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x0e0f17);

        const camera = new THREE.PerspectiveCamera(40, (window.innerWidth - 300) / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 4.5, 5.5);
        camera.lookAt(0, -0.2, 0);

        const container = document.getElementById('canvas-container');
        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(container.clientWidth, container.clientHeight);
        renderer.shadowMap.enabled = true;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        container.appendChild(renderer.domElement);

        // --- STAGE LIGHTING SETUP ---
        const ambient = new THREE.AmbientLight(0xffffff, 0.5);
        scene.add(ambient);

        const studioLight = new THREE.DirectionalLight(0xffffff, 1.2);
        studioLight.position.set(5, 8, 5);
        studioLight.castShadow = true;
        scene.add(studioLight);

        const glowingRimLight = new THREE.PointLight(0x4eedf6, 0.8, 10);
        glowingRimLight.position.set(-3, 2, -2);
        scene.add(glowingRimLight);

        // --- PHYSICAL STAGE ENVIRONMENT GENERATION ---
        // Elegant cosmetic presentation counter table
        const tableGeo = new THREE.CylinderGeometry(2.5, 2.7, 0.2, 64);
        const tableMat = new THREE.MeshStandardMaterial({ color: 0x1c1e2e, roughness: 0.3, metalness: 0.2 });
        const tableMesh = new THREE.Mesh(tableGeo, tableMat);
        tableMesh.position.y = -1.1;
        scene.add(tableMesh);

        // Standard Mixing Bowl Geometry Node
        const bowlGroup = new THREE.Group();
        const outerBowlGeo = new THREE.CylinderGeometry(1.2, 0.8, 0.9, 32, 1, true);
        const bowlMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.1, metalness: 0.9, side: THREE.DoubleSide });
        const outerBowl = new THREE.Mesh(outerBowlGeo, bowlMat);
        bowlGroup.add(outerBowl);

        const baseBowlGeo = new THREE.CylinderGeometry(0.8, 0.8, 0.05, 32);
        const baseBowl = new THREE.Mesh(baseBowlGeo, bowlMat);
        baseBowl.position.y = -0.45;
        bowlGroup.add(baseBowl);
        
        bowlGroup.position.y = -0.4;
        scene.add(bowlGroup);

        // Dynamic Fluid Layer Matrix Mesh
        const fluidGeo = new THREE.CylinderGeometry(1.12, 0.82, 0.5, 32);
        const fluidMat = new THREE.MeshStandardMaterial({ color: 0x222538, roughness: 0.05, transparent: true, opacity: 0.4 });
        const fluidMesh = new THREE.Mesh(fluidGeo, fluidMat);
        fluidMesh.position.y = -0.18;
        bowlGroup.add(fluidMesh);

        // Particle stream array configuration arrays
        const particles = [];
        const particleGroup = new THREE.Group();
        scene.add(particleGroup);

        // --- CORE GAMEPLAY LOGIC FUNCTIONS ---
        function injectIngredient(colorHex, name) {
            if (blendingActive) return;
            
            ingredientsCount++;
            const incomingColor = new THREE.Color(colorHex);
            
            // Calculate dynamic color blending algorithms natively
            if (ingredientsCount === 1) {
                mixedColorValues.copy(incomingColor);
                fluidMat.opacity = 0.85;
            } else {
                mixedColorValues.lerp(incomingColor, 0.5);
            }
            
            fluidMat.color.copy(mixedColorValues);

            // Generate high-juice drop particles tracking item generation pipelines
            for (let i = 0; i < 15; i++) {
                const pGeo = new THREE.SphereGeometry(0.05, 8, 8);
                const pMat = new THREE.MeshBasicMaterial({ color: colorHex });
                const pMesh = new THREE.Mesh(pGeo, pMat);
                
                pMesh.position.set((Math.random() - 0.5) * 0.4, 1.8 + (Math.random() * 0.4), (Math.random() - 0.5) * 0.4);
                pMesh.userData = { speedY: -0.06 - Math.random() * 0.04, targetY: -0.3 + (Math.random() * 0.1) };
                particleGroup.add(pMesh);
                particles.push(pMesh);
            }

            // Update interactive UI parameters dynamically
            if (ingredientsCount >= 2) {
                document.getElementById('blend-trigger').disabled = false;
                document.getElementById('hud-instruction').innerText = "Step 2: Balance complete. Trigger the texture blender tracking loop!";
            } else {
